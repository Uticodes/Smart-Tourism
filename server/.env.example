# Copy this file to .env and fill in your own values.
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=tourism
DB_PASSWORD=change_me
DB_NAME=smart_tourism

# Long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1d

# Demo accounts created by `npm run db:setup`
SEED_ADMIN_EMAIL=admin@smarttourism.test
SEED_ADMIN_PASSWORD=Admin@12345
SEED_USER_PASSWORD=Tourist@12345

# FCT bounding box (approximate; see build plan)
FCT_MIN_LAT=8.30
FCT_MAX_LAT=9.40
FCT_MIN_LNG=6.70
FCT_MAX_LNG=7.70

# Google Maps server-side key (Places API (New) enabled), used by `npm run data:verify`
GOOGLE_MAPS_SERVER_KEY=
