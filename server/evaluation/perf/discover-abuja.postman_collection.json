{
  "info": {
    "name": "Discover Abuja – TC-PERF-01",
    "description": "Section 3.8.3 latency test: location search, recommendations and report submission, each called once per iteration. Run 50 iterations with `npm run eval:perf`, or import into Postman and use the Collection Runner (set baseUrl, authCookie and photoPath first).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" },
    { "key": "authCookie", "value": "" },
    { "key": "photoPath", "value": "" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// A different point in central Abuja every iteration, so results are not served from one cached spot.",
          "pm.variables.set('lat', (9.00 + Math.random() * 0.12).toFixed(6));",
          "pm.variables.set('lng', (7.40 + Math.random() * 0.12).toFixed(6));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Location search",
      "request": {
        "method": "GET",
        "header": [{ "key": "Cookie", "value": "{{authCookie}}" }],
        "url": "{{baseUrl}}/api/attractions/nearby?lat={{lat}}&lng={{lng}}&radius=10"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('200 OK', () => pm.response.to.have.status(200));",
        "pm.test('returns attractions', () => pm.expect(pm.response.json().attractions).to.be.an('array'));",
        "pm.test('under 2.0 s', () => pm.expect(pm.response.responseTime).to.be.below(2000));"
      ] } }]
    },
    {
      "name": "Recommendations",
      "request": {
        "method": "GET",
        "header": [{ "key": "Cookie", "value": "{{authCookie}}" }],
        "url": "{{baseUrl}}/api/recommendations?lat={{lat}}&lng={{lng}}&radius=15"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('200 OK', () => pm.response.to.have.status(200));",
        "pm.test('personalised ranking', () => pm.expect(pm.response.json().personalised).to.equal(true));",
        "pm.test('under 2.0 s', () => pm.expect(pm.response.responseTime).to.be.below(2000));"
      ] } }]
    },
    {
      "name": "Report submission",
      "event": [
        { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
          "// Spread reports across the FCT so the 150 m duplicate check does not stop them.",
          "pm.variables.set('rlat', (8.45 + Math.random() * 0.85).toFixed(6));",
          "pm.variables.set('rlng', (6.80 + Math.random() * 0.80).toFixed(6));",
          "pm.variables.set('rname', 'Performance test site ' + pm.info.iteration);"
        ] } },
        { "listen": "test", "script": { "type": "text/javascript", "exec": [
          "pm.test('201 Created', () => pm.response.to.have.status(201));",
          "pm.test('saved as pending', () => pm.expect(pm.response.json().report.status).to.equal('pending'));",
          "pm.test('under 2.0 s', () => pm.expect(pm.response.responseTime).to.be.below(2000));"
        ] } }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Cookie", "value": "{{authCookie}}" }],
        "url": "{{baseUrl}}/api/reports",
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "site_name", "value": "{{rname}}", "type": "text" },
            { "key": "category_id", "value": "2", "type": "text" },
            { "key": "description", "value": "Generated by the TC-PERF-01 latency test. Not a real place.", "type": "text" },
            { "key": "latitude", "value": "{{rlat}}", "type": "text" },
            { "key": "longitude", "value": "{{rlng}}", "type": "text" },
            { "key": "public_access", "value": "true", "type": "text" },
            { "key": "different_place", "value": "true", "type": "text" },
            { "key": "photos", "type": "file", "src": "{{photoPath}}" }
          ]
        }
      }
    }
  ]
}
