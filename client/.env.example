# Google Maps Platform browser key. Enable "Maps JavaScript API" and "Routes API" for it,
# and restrict it by HTTP referrer to http://localhost:5173/* (and your live site's address later).
VITE_GOOGLE_MAPS_BROWSER_KEY=
# Map ID from Google Cloud → Google Maps Platform → Map management (type: JavaScript, Vector).
# Needed for the custom pins. DEMO_MAP_ID works for development.
VITE_GOOGLE_MAP_ID=DEMO_MAP_ID
